# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this in AI Studio Secrets or Vercel Project Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned via Google Maps Platform setup.
VITE_GOOGLE_MAPS_API_KEY=""

# Optional Server-Side Zap UPI & Payment Gateway Credentials (set in Vercel Env Vars, never in client)
ZAP_UPI_API_KEY=""
ZAP_UPI_SECRET_KEY=""
ZAP_UPI_MERCHANT_ID=""
ZAP_UPI_CREATE_URL="https://api.zapupi.com/api/create-order"
ZAP_UPI_VERIFY_URL="https://api.zapupi.com/api/check-order-status"
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""

# Optional Vercel / Custom Firebase Overrides (defaults to firebase-applet-config.json when unset)
FIREBASE_API_KEY=""
ADMIN_EMAILS=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
