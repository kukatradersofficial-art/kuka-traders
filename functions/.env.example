SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="kukatraders.official@gmail.com"
SMTP_PASS=""
SMTP_FROM="KUKA TRADERS <kukatraders.official@gmail.com>"
RESEND_API_KEY=""
