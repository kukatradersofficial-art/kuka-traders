{
  "name": "kuka-traders-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions v2 for KUKA TRADERS automated transactional order status emails",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.3"
  },
  "private": true
}
